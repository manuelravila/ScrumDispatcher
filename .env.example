# Copy to .env (git-ignored) next to dispatcher.py, or set COMPANY_HOME to your data dir.
# Real environment variables win over this file.
COMPANY_HOME=/opt/scrum-dispatcher
OPERATOR_NAME=Alex
OPERATOR_HANDLE=alex            # Nextcloud username of the human who decides (no @)
LEGACY_DISPATCHER_NAME=HQ
TZ_NAME=UTC                     # e.g. America/Toronto, used for reports and limit-reset times
AGENT_MAIL_DOMAIN=agents.example.com
MUSE_ENV_FILE=/opt/scrum-dispatcher/secrets/nextcloud-muse.env   # NC_USER / NC_PASSWORD of the test agent
HERMES_HOME=/home/you/.hermes
HERMES_AGENTS={"oscar": null}   # JSON: agent -> Hermes profile (null = default)
EXTRA_PATH=/home/you/.local/bin
